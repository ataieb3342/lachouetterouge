{
	"name": "lachouetterouge-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"outils:pages": "node --experimental-strip-types scripts/pages-outils.js",
		"test": "node --experimental-strip-types --test tests/*.test.ts garde-fous/*.test.ts src/lib/server/tests/*.test.js",
		"garde-fous:migrations": "node --experimental-strip-types garde-fous/empreintes-migrations.ts",
		"verifier": "npm run check && npm test && npm run build"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/qrcode": "^1.5.6",
		"@types/turndown": "^5.0.6",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"markdown-it": "^15.0.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"turndown": "^7.2.4"
	},
	"engines": {
		"node": ">=24"
	},
	"description": "Site de La chouette rouge, collectif militant du centre de Dijon"
}
